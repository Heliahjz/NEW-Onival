rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Connection test path
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Primary Onival Cloud Store state collection (used by both client & server for instant zero-downtime migration & seeding)
    match /onival_store/{docId} {
      allow get, list: if true;
      allow create, update: if isValidId(docId)
        && incoming().keys().hasAll(['updatedAt', 'version', 'payloadJson'])
        && incoming().keys().hasOnly(['updatedAt', 'version', 'payloadJson'])
        && incoming().updatedAt is string && incoming().updatedAt.size() <= 64
        && incoming().version is number
        && incoming().payloadJson is string && incoming().payloadJson.size() <= 950000;
      allow delete: if false;
    }

    // Individual Products collection (for direct Firestore inspection & seeding)
    match /products/{productId} {
      allow get, list: if true;
      allow create, update: if isValidId(productId)
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().price is number;
      allow delete: if isValidId(productId);
    }

    // Admin account configuration collection (locked down to authenticated admin UID only)
    match /admin_accounts/{adminId} {
      allow read, write: if false;
    }
  }
}
